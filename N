    Instance.new("UIListLayout", TabList).Padding = dim(0, 5)
    local PageHolder = Instance.new("Frame", Inner); PageHolder.Size = dim2(1, -135, 1, -60); PageHolder.Position = dim2(0, 130, 0, 50); PageHolder.BackgroundTransparency = 1

    function Library:AddTab(name)
        local TabButton = Instance.new("TextButton", TabList); TabButton.Size = dim2(1, -10, 0, 35); TabButton.BackgroundColor3 = rgb(25, 27, 27); TabButton.Text = name; TabButton.TextColor3 = themes.deselected; TabButton.Font = 2
        local Page = Instance.new("ScrollingFrame", PageHolder); Page.Size = dim2(1, 0, 1, 0); Page.Visible = false; Page.BackgroundTransparency = 1; Page.ScrollBarThickness = 0
        Instance.new("UIListLayout", Page).Padding = dim(0, 5)
        TabButton.MouseButton1Click:Connect(function()
            for _, t in pairs(Library.Tabs) do t.Button.TextColor3 = themes.deselected; t.Page.Visible = false end
            TabButton.TextColor3 = themes.accent; Page.Visible = true
        end)
        table.insert(Library.Tabs, {Button = TabButton, Page = Page})
        if #Library.Tabs == 1 then TabButton.TextColor3 = themes.accent; Page.Visible = true end
        return Page
    end

    function Library:AddToggle(page, text, callback)
        local Tgl = Instance.new("TextButton", page); Tgl.Size = dim2(1, -10, 0, 35); Tgl.BackgroundColor3 = rgb(30, 32, 32); Tgl.Text = "  " .. text; Tgl.TextColor3 = rgb(200, 200, 200); Tgl.Font = 2; Tgl.TextXAlignment = 0
        local state = false
        Tgl.MouseButton1Click:Connect(function() state = not state; Tgl.TextColor3 = state and themes.accent or rgb(200, 200, 200); callback(state) end)
        Instance.new("UICorner", Tgl).CornerRadius = dim(0, 4)
    end

    function Library:AddSlider(page, text, min, max, callback)
        local frame = Instance.new("Frame", page); frame.Size = dim2(1, -10, 0, 45); frame.BackgroundTransparency = 1
        local label = Instance.new("TextLabel", frame); label.Size = dim2(1, 0, 0, 20); label.Text = text; label.TextColor3 = themes.white; label.BackgroundTransparency = 1; label.Font = 2
        local bar = Instance.new("TextButton", frame); bar.Size = dim2(1, 0, 0, 10); bar.Position = dim2(0, 0, 0, 22); bar.BackgroundColor3 = rgb(40,40,40); bar.Text = ""
        local fill = Instance.new("Frame", bar); fill.Size = dim2(0.2, 0, 1, 0); fill.BackgroundColor3 = themes.accent
        bar.InputBegan:Connect(function(input)
            if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
                local move; move = InputService.InputChanged:Connect(function(i)
                    if i.UserInputType == Enum.UserInputType.MouseMovement or i.UserInputType == Enum.UserInputType.Touch then
                        local p = math.clamp((i.Position.X - bar.AbsolutePosition.X) / bar.AbsoluteSize.X, 0, 1)
                        fill.Size = dim2(p, 0, 1, 0); callback(math.floor(min + (max - min) * p))
                    end
                end)
                InputService.InputEnded:Connect(function(i) if i.UserInputType == Enum.UserInputType.MouseButton1 or i.UserInputType == Enum.UserInputType.Touch then move:Disconnect() end end)
            end
        end)
    end
    
    function Library:AddButton(page, text, callback)
        local Btn = Instance.new("TextButton", page); Btn.Size = dim2(1, -10, 0, 35); Btn.BackgroundColor3 = rgb(30, 32, 32); Btn.Text = text; Btn.TextColor3 = themes.white; Btn.Font = 2
        Btn.MouseButton1Click:Connect(callback)
        Instance.new("UICorner", Btn).CornerRadius = dim(0, 4)
    end

    return Library
end

