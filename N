-- [ FUNCIONES DE DIBUJO Y EFECTOS ]
local function CreateGalaxy(parent)
    local canvas = Instance.new("Frame", parent); canvas.Size = dim2(1, 0, 1, 0); canvas.BackgroundTransparency = 1; canvas.ClipsDescendants = true
    local stars = {}
    for i = 1, 65 do
        local star = Instance.new("Frame", canvas); star.Size = dim2(0, math.random(1,2), 0, math.random(1,2))
        star.Position = dim2(math.random(), 0, math.random(), 0); star.BackgroundColor3 = rgb(255, 255, 255); star.BorderSizePixel = 0
        table.insert(stars, {frame = star, speed = math.random(6, 14) / 1000})
    end
    RunService.Heartbeat:Connect(function()
        for _, s in stars do
            local nY = s.frame.Position.Y.Scale + s.speed
            if nY > 1 then nY = -0.02 end
            s.frame.Position = dim2(s.frame.Position.X.Scale, 0, nY, 0)
        end
    end)
end

local function ApplySplitEffect(obj)
    local grad = Instance.new("UIGradient", obj)
    grad.Color = ColorSequence.new({
        ColorSequenceKeypoint.new(0, themes.white),
        ColorSequenceKeypoint.new(0.5, themes.white),
        ColorSequenceKeypoint.new(0.501, themes.accent),
        ColorSequenceKeypoint.new(1, themes.accent)
    })
end

local function ApplyShadowBorder(obj)
    local Glow = Instance.new("ImageLabel", obj)
    Glow.BackgroundTransparency = 1; Glow.Position = dim2(0, -15, 0, -15); Glow.Size = dim2(1, 30, 1, 30); Glow.ZIndex = obj.ZIndex - 1
    Glow.Image = "rbxassetid://5028857084"; Glow.ScaleType = Enum.ScaleType.Slice; Glow.SliceCenter = Rect.new(24, 24, 276, 276)
    ApplySplitEffect(Glow)

    local stroke = Instance.new("UIStroke", obj)
    stroke.Thickness = 1.8; stroke.ApplyStrokeMode = Enum.ApplyStrokeMode.Border; stroke.Color = themes.white; ApplySplitEffect(stroke)
end

local function MakeDraggable(obj)
    local dragging, dragStart, startPos
    obj.InputBegan:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
            dragging = true; dragStart = input.Position; startPos = obj.Position
        end
    end)
    InputService.InputChanged:Connect(function(input)
        if dragging and (input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch) then
            local delta = input.Position - dragStart
            obj.Position = dim2(startPos.X.Scale, startPos.X.Offset + delta.X, startPos.Y.Scale, startPos.Y.Offset + delta.Y)
        end
    end)
    InputService.InputEnded:Connect(function(input) if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then dragging = false end end)
end

-- [ LÓGICA DE COMBATE ]
local FOVCircle = Drawing.new("Circle")
FOVCircle.Thickness = 1; FOVCircle.Color = themes.accent; FOVCircle.Filled = false; FOVCircle.Visible = false

local function GetClosestToFOV()
    local target, closest = nil, Combat_Settings.FOV
    local center = Vector2.new(Camera.ViewportSize.X / 2, Camera.ViewportSize.Y / 2)

    for _, p in pairs(Players:GetPlayers()) do
        if p ~= LocalPlayer and p.Character and p.Character:FindFirstChild("Humanoid") and p.Character:FindFirstChild("Head") then
            if p.Character.Humanoid.Health > 0 then
                local pos, onScreen = Camera:WorldToViewportPoint(p.Character.Head.Position)
                if onScreen then
                    local dist = (Vector2.new(pos.X, pos.Y) - center).Magnitude
                    if dist < closest then closest = dist; target = p end
                end
            end
        end
    end
    return target
end

-- SILENT AIM HOOK
local oldNamecall
oldNamecall = hookmetamethod(game, "__namecall", function(self, ...)
    local args = {...}
    local method = getnamecallmethod()
    if not checkcaller() and Combat_Settings.SilentAim and method == "FireServer" then
        local target = GetClosestToFOV()
        if target and target.Character:FindFirstChild("Head") then
            for i, arg in pairs(args) do
                if typeof(arg) == "Vector3" then args[i] = target.Character.Head.Position end
            end
        end
    end
    return oldNamecall(self, unpack(args))
end)

-- [ ESP COMPLETO ]
local function CreateESP(player)
    local Box = Drawing.new("Square"); Box.Visible = false; Box.Color = themes.white; Box.Thickness = 1; Box.Filled = false
    local HealthBar = Drawing.new("Line"); HealthBar.Visible = false; HealthBar.Color = rgb(0, 255, 0); HealthBar.Thickness = 2
    local Tracer = Drawing.new("Line"); Tracer.Visible = false; Tracer.Color = themes.white; Tracer.Thickness = 1
    local NameTag = Drawing.new("Text"); NameTag.Visible = false; NameTag.Color = themes.white; NameTag.Center = true; NameTag.Outline = true

    RunService.RenderStepped:Connect(function()
        if player.Character and player.Character:FindFirstChild("HumanoidRootPart") and player ~= LocalPlayer then
            local Root = player.Character.HumanoidRootPart
            local Pos, OnScreen = Camera:WorldToViewportPoint(Root.Position)
            if OnScreen then
                local Size = (Camera:WorldToViewportPoint(Root.Position + Vector3.new(0, 3, 0)).Y - Camera:WorldToViewportPoint(Root.Position - Vector3.new(0, 3, 0)).Y)
                local BoxSize = Vector2.new(Size / 1.5, Size)
                local BoxPos = Vector2.new(Pos.X - BoxSize.X / 2, Pos.Y - BoxSize.Y / 2)

                Box.Visible = ESP_Settings.Box; Box.Size = BoxSize; Box.Position = BoxPos
                HealthBar.Visible = ESP_Settings.Health
                local health = player.Character.Humanoid.Health / player.Character.Humanoid.MaxHealth
                HealthBar.From = Vector2.new(BoxPos.X - 7, BoxPos.Y + BoxSize.Y)
                HealthBar.To = Vector2.new(BoxPos.X - 7, BoxPos.Y + BoxSize.Y - (BoxSize.Y * health))
                NameTag.Visible = ESP_Settings.Names; NameTag.Text = player.Name; NameTag.Position = Vector2.new(Pos.X, BoxPos.Y - 15)

                if ESP_Settings.Tracers and GetClosestToFOV() == player then
                    local MyHead = Camera:WorldToViewportPoint(LocalPlayer.Character.Head.Position)
                    Tracer.Visible = true; Tracer.From = Vector2.new(MyHead.X, MyHead.Y); Tracer.To = Vector2.new(Pos.X, Pos.Y)
                else Tracer.Visible = false end
            else Box.Visible = false; HealthBar.Visible = false; Tracer.Visible = false; NameTag.Visible = false end
        else Box.Visible = false; HealthBar.Visible = false; Tracer.Visible = false; NameTag.Visible = false end
    end)
end
for _, p in pairs(Players:GetPlayers()) do CreateESP(p) end
Players.PlayerAdded:Connect(CreateESP)

